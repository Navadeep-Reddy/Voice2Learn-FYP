NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Local Whisper (Pass 3): defaults below match the verified local runtime.
# No model is ever downloaded; the in-process adapter loads the cached snapshot with local_files_only=True.
VOICE2LEARN_WHISPER_MODEL_DIR=/home/navadeep/.cache/huggingface/hub/models--Systran--faster-distil-whisper-large-v3/snapshots/c3058b475261292e64a0412df1d2681c06260fab
VOICE2LEARN_WHISPER_DEVICE=cuda
VOICE2LEARN_WHISPER_COMPUTE_TYPE=float16
# Optional neutral concise lesson-context hint.
# VOICE2LEARN_WHISPER_INITIAL_PROMPT=

# Optional neural narration; backend returns 503 and browser TTS is used if unavailable.
VOICE2LEARN_TTS_VOICE=en-US-JennyNeural

# Local Laya Typed-Decisions boundary (classifier remains Nemotron until Pass 8).
VOICE2LEARN_LAYA_DEVICE=auto
